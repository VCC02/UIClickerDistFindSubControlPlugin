procedure InitHandlers;
begin
  OnMQTTError^ := @HandleOnMQTTError;
  OnSendMQTT_Packet^ := @HandleOnSend_MQTT_Packet;
  OnBeforeMQTT_CONNECT^ := @HandleOnBeforeMQTT_CONNECT;
  OnAfterMQTT_CONNACK^ := @HandleOnAfterMQTT_CONNACK;
  OnBeforeSendingMQTT_PUBLISH^ := @HandleOnBeforeSendingMQTT_PUBLISH;
  OnBeforeSendingMQTT_PUBACK^ := @HandleOnBeforeSendingMQTT_PUBACK;
  OnAfterReceivingMQTT_PUBACK^ := @HandleOnAfterReceivingMQTT_PUBACK;
  OnAfterReceivingMQTT_PUBLISH^ := @HandleOnAfterReceivingMQTT_PUBLISH;
  OnBeforeSendingMQTT_PUBREC^ := @HandleOnBeforeSending_MQTT_PUBREC;
  OnAfterReceivingMQTT_PUBREC^ := @HandleOnAfterReceiving_MQTT_PUBREC;
  OnBeforeSendingMQTT_PUBREL^ := @HandleOnBeforeSending_MQTT_PUBREL;
  OnAfterReceivingMQTT_PUBREL^ := @HandleOnAfterReceiving_MQTT_PUBREL;
  OnBeforeSendingMQTT_PUBCOMP^ := @HandleOnBeforeSending_MQTT_PUBCOMP;
  OnAfterReceivingMQTT_PUBCOMP^ := @HandleOnAfterReceiving_MQTT_PUBCOMP;
  OnBeforeSendingMQTT_SUBSCRIBE^ := @HandleOnBeforeSendingMQTT_SUBSCRIBE;
  OnAfterReceivingMQTT_SUBACK^ := @HandleOnAfterReceivingMQTT_SUBACK;
  OnBeforeSendingMQTT_UNSUBSCRIBE^ := @HandleOnBeforeSendingMQTT_UNSUBSCRIBE;
  OnAfterReceivingMQTT_UNSUBACK^ := @HandleOnAfterReceivingMQTT_UNSUBACK;
  OnAfterReceivingMQTT_PINGRESP^ := @HandleOnAfterReceivingMQTT_PINGRESP;
  OnBeforeSendingMQTT_DISCONNECT^ := @HandleOnBeforeSendingMQTT_DISCONNECT;
  OnAfterReceivingMQTT_DISCONNECT^ := @HandleOnAfterReceivingMQTT_DISCONNECT;
  OnBeforeSendingMQTT_AUTH^ := @HandleOnBeforeSendingMQTT_AUTH;
  OnAfterReceivingMQTT_AUTH^ := @HandleOnAfterReceivingMQTT_AUTH;
end;






function GetAPIVersion: DWord; cdecl;
begin
  Result := CActionPlugin_APIVersion;
end;


procedure GetListOfProperties(APluginReference: Pointer;                 //UIClicker passes the plugin reference to the plugin, then the plugin calls some callbacks with that reference
                              AListOfProperties: Pointer;
                              AListOfPropertiesLen: PDWord;
                              AOnActionPlugin_UpdatePropertyIcons: TOnActionPlugin_UpdatePropertyIcons); cdecl;
var
  Properties: string;
begin
  Properties := FillInPropertyDetails;  //Less than 10000 bytes, with the last property being "UpdateBackgroundInterval".
  AListOfPropertiesLen^ := SetPointedContentFromString(Properties, AListOfProperties);

  dmProperties := TdmProperties.Create(nil);
  try
    UpdatePropertyIcons(APluginReference, AOnActionPlugin_UpdatePropertyIcons, dmProperties.imglstProperties, CPropertiesCount);
  finally
    dmProperties.Free;
  end;
end;



type
  TDistPlugin = class
  private
    FPluginReference: Pointer;
    FListOfPluginSettings: Pointer;
    FListOfPluginSettingsLen: PDWord;
    FLatestMsg: string;
    FVarsForWorkers: TVarsForWorkers; //the old VarsForWorkers_Names, VarsForWorkers_Values, VarsForWorkers_EvalBefore
    FAllWorkerBackgroundBmpStr: string;

    FOnActionPlugin_SetTemplateVar: TOnActionPlugin_SetTemplateVar;
    FOnActionPlugin_GetAllTemplateVars: TOnActionPlugin_GetAllTemplateVars;
    FOnActionPlugin_GetAllowedFilesInfo: TOnActionPlugin_GetAllowedFilesInfo;
    FOnActionPlugin_LoadBitmap: TOnActionPlugin_LoadBitmap;
    FOnActionPlugin_AddToLog: TOnActionPlugin_AddToLog;
    FOnActionPlugin_SetResultImg: TOnActionPlugin_SetResultImg;
    FOnActionPlugin_SetBitmap: TOnActionPlugin_SetBitmap;
    FOnActionPlugin_Screenshot: TOnActionPlugin_Screenshot;
    FOnActionPlugin_GetActionContentByIndex: TOnActionPlugin_GetActionContentByIndex;
    FOnActionPlugin_InMemFS: TOnActionPlugin_InMemFS;
    FOnActionPlugin_DebugPoint: TOnActionPlugin_DebugPoint;
    FOnActionPlugin_ExecuteAction: TOnActionPlugin_ExecuteAction;
    FOnActionPlugin_AppProcMsg: TOnActionPlugin_AppProcMsg;
    FOnActionPlugin_GetActionCount: TOnActionPlugin_GetActionCount;
    FOnActionPlugin_GetActionInfoByIndex: TOnActionPlugin_GetActionInfoByIndex;
    FOnActionPlugin_CheckStopAllActionsOnDemand: TOnActionPlugin_CheckStopAllActionsOnDemand;

    UsingCompression: Boolean;
    ListOfPluginSettings: TStringList;
    IndexOfFindSubControlActionProperty: Integer;

    BkArchiveStream: TMemoryStream;
    BkArchive: TMemArchive;
    BkCompressionTime: QWord;   //for statistics only

    FindSubControlFonts: TClkFindControlMatchBitmapTextArr; //used for sorting
    FontsUsedByPmtvs: TStringArray;  //used for sorting and task allocation
    FDistPluginOptions: TDistPluginOptions;

    procedure GetCredentials(ACredentialsFilePath: string; out AUsername, APassword: string);
    procedure GetCredentialsFromInMemFS(ACredentialsFilePath: string; APluginReference: Pointer; AOnActionPlugin_InMemFS: TOnActionPlugin_InMemFS; out AUsername, APassword: string);

    procedure SetTemplateVar(AVarName, AVarValue: string);
    procedure GetAllTemplateVars(out AAllTemplateVars: string);
    function GetPluginSettings: string;
    procedure GenerateSomeResultImg(AListOfAllVars: TStringList);
    procedure SaveBitmapToExtRenderingInMemFS;
    function HashFoundInFileCacheInfo(AFileCacheInfo: TStringList; AHash: string): Boolean;
    procedure OpenBkArchiveForAddingBackground(AArchiveHandlers: TArchiveHandlers);
    procedure OpenWorkerArchivesForAddingBitmaps(AArchiveHandlers: TArchiveHandlers);
    function FileExistsInCache(AWorkerCache: TStringList; AFileName: string; AFileContent: TMemoryStream): Boolean;
    function BackgroundChanged(AListOfAllVars: TStringList; AImageSource, AImageSourceFileNameLocation, ASourceFileName: string): Boolean;
    function AddBackgroundBitmapToWorkerArchives(AListOfAllVars: TStringList; AImageSource, AImageSourceFileNameLocation, ASourceFileName: string; out ABackgroundSize: Int64; out ABackgroundWidth, ABackgroundHeight: Integer): Boolean;
    function GetFullTemplatesDir: string;
    function ResolveTemplatePath(APath: string): string;
    procedure AddBitmapsToWorkerArchives(AListOfAllVars: TStringList);
    procedure GetFontsUsedByPmtvs(AListOfAllVars: TStringList; var AFindSubControlOptions: TClkFindSubControlOptions; var AFontsUsedByPmtvs: TStringArray);
    procedure AssignTasksToWorkers(AMaxSplitActionsCount: Integer; AListOfBmps, AListOfPmtvs, AListOfAllVars: TStringList; var AFindSubControlOptions: TClkFindSubControlOptions);
    function CloseBkArchive: Boolean;
    function CloseWorkerArchives: Boolean;
    function UpdateBkArchiveWithNewBackground(AListOfAllVars: TStringList): Boolean;
    function GetFindSubControlContent(AListOfAllVars: TStringList; out AHasTxtTasks: Boolean): Boolean;
    function ExecPlugin: Boolean;

    procedure HandleOnAddToLog(s: string);
    procedure HandleOnError(s: string);

    function HandleOnSaveWorkerCapabilitiesCache: Boolean;
    function HandleOnLoadWorkerCapabilitiesCache: Boolean;

    procedure HandleOnGetMQTTCredentials(out AUserName, APassword: string);
    procedure HandleOnAppProcMsg;
  public
    constructor Create;
    destructor Destroy; override;
  end;


constructor TDistPlugin.Create;
begin
  inherited Create;
  FindSubControlFonts := nil;
  FLatestMsg := '';

  DistExec := TDistExec.Create;

  DistExec.OnAddToLog := HandleOnAddToLog;
  DistExec.OnError := HandleOnError;
  DistExec.OnGetMQTTCredentials := HandleOnGetMQTTCredentials;
  DistExec.OnAppProcMsg := HandleOnAppProcMsg;
  DistExec.OnSaveWorkerCapabilitiesCache := HandleOnSaveWorkerCapabilitiesCache;
  DistExec.OnLoadWorkerCapabilitiesCache := HandleOnLoadWorkerCapabilitiesCache;
end;


destructor TDistPlugin.Destroy;
begin
  DistExec.Free;
  inherited Destroy;
end;


procedure TDistPlugin.HandleOnAddToLog(s: string);
begin
  AddToLog(s);
end;


procedure TDistPlugin.HandleOnError(s: string);
begin
  FLatestMsg := s;
end;


function TDistPlugin.HandleOnSaveWorkerCapabilitiesCache: Boolean;
begin
  Result := ActionPlugin_ExecuteActionCallback(FPluginReference, @FDistPluginOptions.SaveWorkerCapabilitiesCacheAction[1]);
end;


function TDistPlugin.HandleOnLoadWorkerCapabilitiesCache: Boolean;
begin
  Result := ActionPlugin_ExecuteActionCallback(FPluginReference, @FDistPluginOptions.LoadWorkerCapabilitiesCacheAction[1]);
end;


procedure TDistPlugin.HandleOnGetMQTTCredentials(out AUserName, APassword: string);
begin
  if Pos('Mem:\', FDistPluginOptions.CredentialsFullFileName) = 1 then
    GetCredentialsFromInMemFS(FDistPluginOptions.CredentialsFullFileName, FPluginReference, ActionPlugin_InMemFSCallback, AUserName, APassword)
  else
    GetCredentials(FDistPluginOptions.CredentialsFullFileName, AUserName, APassword);
end;


procedure TDistPlugin.HandleOnAppProcMsg;
begin
  AppProcMsg;
end;


procedure TDistPlugin.GetCredentials(ACredentialsFilePath: string; out AUsername, APassword: string);
var
  Ini: TClkIniReadonlyFile;
begin
  Ini := TClkIniReadonlyFile.Create(ACredentialsFilePath);
  try
    AUsername := Ini.ReadString('Credentials', 'Username', '');
    APassword := Ini.ReadString('Credentials', 'Password', '');
  finally
    Ini.Free;
  end;
end;


procedure TDistPlugin.GetCredentialsFromInMemFS(ACredentialsFilePath: string; APluginReference: Pointer; AOnActionPlugin_InMemFS: TOnActionPlugin_InMemFS; out AUsername, APassword: string);
var
  Ini: TClkIniReadonlyFile;
  PluginInMemFS: TPluginInMemFileSystem;
  Content: TMemoryStream;
begin
  AddToLog('Loading credentials file from ' + ACredentialsFilePath);

  PluginInMemFS := TPluginInMemFileSystem.Create;
  try
    Content := TMemoryStream.Create;
    try
      PluginInMemFS.PluginReference := APluginReference;
      if PluginInMemFS.FileExistsInMem(AOnActionPlugin_InMemFS, ACredentialsFilePath) then
      begin
        Content.SetSize(PluginInMemFS.GetFileSize(AOnActionPlugin_InMemFS, ACredentialsFilePath));
        AddToLog('Credentials file size: ' + IntToStr(Content.Size));
        PluginInMemFS.LoadFileFromMem(AOnActionPlugin_InMemFS, ACredentialsFilePath, Content.Memory);

        Ini := TClkIniReadonlyFile.Create(Content);
        try
          AUsername := Ini.ReadString('Credentials', 'Username', '');
          APassword := Ini.ReadString('Credentials', 'Password', '');

          //AddToLog('Username: ' + AUsername + '  Password: ' + APassword);  //for debugging only
        finally
          Ini.Free;
        end;
      end
      else
      begin
        AUsername := 'not found';
        APassword := 'not found';
      end;
    finally
      Content.Free;
    end;
  finally
    PluginInMemFS.Free;
  end;
end;


procedure TDistPlugin.SetTemplateVar(AVarName, AVarValue: string);
begin
  FOnActionPlugin_SetTemplateVar(FPluginReference, @AVarName[1], @AVarValue[1]);
end;


procedure TDistPlugin.GetAllTemplateVars(out AAllTemplateVars: string);  //AAllTemplateVars are encoded as CRLF separated key=value strings, ready to be used on a TStringlist
var
  Buffer: string;
  AllTemplateVarsPtr: Pointer;
  NameLengthDWord: DWord;
begin
  SetLength(Buffer, CMaxSharedStringLength + 1);
  AllTemplateVarsPtr := @Buffer[1];
  NameLengthDWord := 0;
  AAllTemplateVars := '';

  FOnActionPlugin_GetAllTemplateVars(FPluginReference, AllTemplateVarsPtr, @NameLengthDWord);  //decode action execution results

  SetPointedContentToString(AllTemplateVarsPtr, AAllTemplateVars);
  SetLength(AAllTemplateVars, NameLengthDWord);
end;


function TDistPlugin.GetPluginSettings: string;
begin
  SetLength(Result, CMaxSharedStringLength);
  SetPointedContentToString(FListOfPluginSettings, Result);
  SetLength(Result, FListOfPluginSettingsLen^);
end;


procedure TDistPlugin.GenerateSomeResultImg(AListOfAllVars: TStringList);
var
  TempBmp, BkBmp: TBitmap;
  TempStream: TMemoryStream;
  TempFnm: string;
begin
  TempBmp := TBitmap.Create;
  BkBmp := TBitmap.Create;
  TempStream := TMemoryStream.Create;
  try
    TempBmp.Width := 700;
    TempBmp.Height := 400;
    TempBmp.Canvas.Brush.Color := clBlack;
    TempBmp.Canvas.Pen.Color := clBlack;

    TempFnm := ExtractFilePath(ParamStr(0)) + 'Tests\TestFiles\Gradient30deg.bmp';
    if LoadBitmap(FPluginReference,
                  FOnActionPlugin_GetAllowedFilesInfo,
                  FOnActionPlugin_LoadBitmap,
                  FOnActionPlugin_AddToLog,
                  AListOfAllVars,
                  TempFnm,
                  BkBmp,
                  isflDisk) then
      TempBmp.Canvas.Draw(50, 25, BkBmp);

    TempBmp.Canvas.Font.Color := clYellow;
    TempBmp.Canvas.Font.Name := 'Courier New';
    TempBmp.Canvas.TextOut(30, 10, 'Plugin done.');

    TempBmp.SaveToStream(TempStream);
    FOnActionPlugin_SetResultImg(FPluginReference, 0, 0, 0, TempStream.Memory, TempStream.Size, TempBmp.Width, TempBmp.Height);
  finally
    TempStream.Free;
    TempBmp.Free;
    BkBmp.Free;
  end;
end;


procedure TDistPlugin.SaveBitmapToExtRenderingInMemFS;
var
  Bmp: TBitmap;
  MemStream: TMemoryStream;
begin
  Bmp := TBitmap.Create;
  MemStream := TMemoryStream.Create;
  try
    Bmp.Width := 150;
    Bmp.Height := 180;
    Bmp.PixelFormat := pf24bit;
    Bmp.Canvas.Brush.Color := clBlack;
    Bmp.Canvas.Font.Color := clYellow;
    Bmp.Canvas.TextOut(50, 60, 'Generated bitmap');
    Bmp.Canvas.TextOut(50, 130, 'Generated bitmap');
    bmp.SaveToStream(MemStream);

    FOnActionPlugin_SetBitmap(FPluginReference, @string('GenBmp.bmp')[1], MemStream.Memory, MemStream.Size, Bmp.Width, Bmp.Height);
  finally
    Bmp.Free;
    MemStream.Free;
  end;
end;

//var
//  SplitActions: array of TClkFindControlOptions;

function TDistPlugin.HashFoundInFileCacheInfo(AFileCacheInfo: TStringList; AHash: string): Boolean;
var
  i: Integer;
  s: string;
begin
  Result := False;

  for i := 0 to AFileCacheInfo.Count - 1 do
  begin
    s := AFileCacheInfo.Strings[i];
    s := Copy(s, Pos(CDefaultInMemFileNameHashSeparator, s) + Length(CDefaultInMemFileNameHashSeparator), MaxInt);

    if s = AHash then
    begin
      Result := True;
      Break;
    end;
  end;
end;


procedure TDistPlugin.OpenBkArchiveForAddingBackground(AArchiveHandlers: TArchiveHandlers);
begin
  BkArchive.OpenArchive(BkArchiveStream, True);
  BkArchive.OnCompress := AArchiveHandlers.HandleOnCompress;
  BkArchive.OnDecompress := AArchiveHandlers.HandleOnDecompress;
  BkArchive.OnComputeArchiveHash := AArchiveHandlers.HandleOnComputeArchiveHash;
  BkArchive.Password := '';

  BkArchive.CompressionLevel := 9 * Ord(UsingCompression);
end;


procedure TDistPlugin.OpenWorkerArchivesForAddingBitmaps(AArchiveHandlers: TArchiveHandlers);
var
  i: Integer;
begin
  for i := 0 to DistExec.AllWorkersLength - 1 do
  begin
    DistExec.AllWorkers[i].Archive.OpenArchive(DistExec.AllWorkers[i].ArchiveStream, True);
    DistExec.AllWorkers[i].Archive.OnCompress := AArchiveHandlers.HandleOnCompress;
    DistExec.AllWorkers[i].Archive.OnDecompress := AArchiveHandlers.HandleOnDecompress;
    DistExec.AllWorkers[i].Archive.OnComputeArchiveHash := AArchiveHandlers.HandleOnComputeArchiveHash;
    DistExec.AllWorkers[i].Archive.Password := '';

    DistExec.AllWorkers[i].Archive.CompressionLevel := 9 * Ord(UsingCompression);
  end;

  OpenBkArchiveForAddingBackground(AArchiveHandlers);
end;


function TDistPlugin.FileExistsInCache(AWorkerCache: TStringList; AFileName: string; AFileContent: TMemoryStream): Boolean;
var
  FileHash: string;
begin
  FileHash := ClickerExtraUtils.ComputeHash(AFileContent.Memory, AFileContent.Size);
  Result := AWorkerCache.IndexOf(AFileName + CDefaultInMemFileNameHashSeparator + FileHash) > -1;
end;


function TDistPlugin.BackgroundChanged(AListOfAllVars: TStringList; AImageSource, AImageSourceFileNameLocation, ASourceFileName: string): Boolean;
var
  TempBk, PreBk: TMemoryStream;
  BkFileNameLocation: TImageSourceFileNameLocation;
begin
  Result := True;
  BkFileNameLocation := TImageSourceFileNameLocation(StrToIntDef(AImageSourceFileNameLocation, 1));

  PreBk := TMemoryStream.Create;
  try
    ASourceFileName := CScreenshotFilename;

    if LoadBitmapAsStream(FPluginReference, FOnActionPlugin_GetAllowedFilesInfo, FOnActionPlugin_LoadBitmap, FOnActionPlugin_AddToLog, AListOfAllVars, ASourceFileName, PreBk, BkFileNameLocation) then
    begin
      if AImageSource = '0' then  //isScreenshot
      begin
        //this updates the background in memory
        FOnActionPlugin_Screenshot(FPluginReference, @string(ListOfPluginSettings.ValueFromIndex[CFindSubControlActionPropertyIndex])[1]);
      end;

      TempBk := TMemoryStream.Create;
      try
        if LoadBitmapAsStream(FPluginReference, FOnActionPlugin_GetAllowedFilesInfo, FOnActionPlugin_LoadBitmap, FOnActionPlugin_AddToLog, AListOfAllVars, ASourceFileName, TempBk, BkFileNameLocation) then
        begin
          if PreBk.Size = TempBk.Size then
            if CompareMem(PreBk.Memory, TempBk.Memory, PreBk.Size) then
            begin
              Result := False;
              Exit;
            end;
        end;
      finally
        TempBk.Free;
      end;
    end  //LoadBitmapAsStream - PreBk
    else
      raise Exception.Create('----------- LoadBitmapAsStream(PreBk) is False. Probably the file does not exist: ' + ASourceFileName);
  finally
    PreBk.Free;
  end;
end;


function TDistPlugin.AddBackgroundBitmapToWorkerArchives(AListOfAllVars: TStringList; AImageSource, AImageSourceFileNameLocation, ASourceFileName: string; out ABackgroundSize: Int64; out ABackgroundWidth, ABackgroundHeight: Integer): Boolean;
var
  TempBk: TMemoryStream;
  BkFileNameLocation: TImageSourceFileNameLocation;
  TempBmp: TBitmap;
begin
  Result := True;
  ABackgroundSize := -2; //init with something
  ABackgroundWidth := 1;
  ABackgroundHeight := 1;

  BkFileNameLocation := TImageSourceFileNameLocation(StrToIntDef(AImageSourceFileNameLocation, 1));

  if AImageSource = '0' then  //isScreenshot
  begin
    if DistExec.VerbLevel < 2 then
      AddToLog('----------- ImageSource is a screenshot. Taking the screenshot, using the settings from ' + ListOfPluginSettings.ValueFromIndex[CFindSubControlActionPropertyIndex] + ' action.');

    FOnActionPlugin_Screenshot(FPluginReference, @string(ListOfPluginSettings.ValueFromIndex[CFindSubControlActionPropertyIndex])[1]);

    if DistExec.VerbLevel < 2 then
      AddToLog('----------- The screenshot should be found in in-mem FS, as ' + CScreenshotFilename);

    ASourceFileName := CScreenshotFilename;
  end;

  if DistExec.VerbLevel < 2 then
    AddToLog('----------- Loading background bitmap as stream and adding it to archive...');

  TempBk := TMemoryStream.Create;
  try
    if LoadBitmapAsStream(FPluginReference, FOnActionPlugin_GetAllowedFilesInfo, FOnActionPlugin_LoadBitmap, FOnActionPlugin_AddToLog, AListOfAllVars, ASourceFileName, TempBk, BkFileNameLocation) then
    begin
      ABackgroundSize := TempBk.Size;
      //BkHash := ComputeHash(TempBk.Memory, TempBk.Size);

      //if not FileExistsInCache(AllWorkers[0].FileCacheInfo, CBackgroundFileNameInArchive, TempBk) then    The problem right now, is that the same background archive is sent to all workers. That means the cache has to be verified for all workers and only some of them may need thi archive.
      BkArchive.AddFromStream(CBackgroundFileNameInArchive, TempBk);

      TempBmp := TBitmap.Create;
      try
        TempBk.Position := 0;
        TempBmp.LoadFromStream(TempBk);
        ABackgroundWidth := TempBmp.Width;
        ABackgroundHeight := TempBmp.Height;

        if DistExec.VerbLevel < 2 then
          AddToLog('----------- Background size: ' + IntToStr(TempBmp.Width) + ' : ' + IntToStr(TempBmp.Height));
      finally
        TempBmp.Free;
      end;
    end
    else
    begin
      ABackgroundSize := 0;
      raise Exception.Create('----------- LoadBitmapAsStream is False. Probably the file does not exist: ' + ASourceFileName);
    end;
  finally
    TempBk.Free;
  end;
end;


function TDistPlugin.GetFullTemplatesDir: string;
var
  FullTemplatesDir, AllowedFileDirsForServer, AllowedFileExtensionsForServer: string;
  FullTemplatesDirPtr, AllowedFileDirsForServerPtr, AllowedFileExtensionsForServerPtr: Pointer;
begin
  SetLength(FullTemplatesDir, CMaxSharedStringLength + 1);
  SetLength(AllowedFileDirsForServer, CMaxSharedStringLength + 1);
  SetLength(AllowedFileExtensionsForServer, CMaxSharedStringLength + 1);

  FullTemplatesDirPtr := @FullTemplatesDir[1];
  AllowedFileDirsForServerPtr := @AllowedFileDirsForServer[1];
  AllowedFileExtensionsForServerPtr := @AllowedFileExtensionsForServer[1];

  FOnActionPlugin_GetAllowedFilesInfo(FPluginReference, FullTemplatesDirPtr, AllowedFileDirsForServerPtr, AllowedFileExtensionsForServerPtr);
  FullTemplatesDir := Copy(FullTemplatesDir, 1, Pos(#0, FullTemplatesDir) - 1);
  Result := FullTemplatesDir;
end;


function TDistPlugin.ResolveTemplatePath(APath: string): string;
begin
  if (Pos('$TemplateDir$', APath) = 0) and
     (Pos('$SelfTemplateDir$', APath) = 0)and
     (Pos('$AppDir$', APath) = 0) then
  begin
    Result := APath;
    Exit;
  end;

  Result := StringReplace(APath, '$TemplateDir$', GetFullTemplatesDir, [rfReplaceAll]);
  Result := StringReplace(Result, '$SelfTemplateDir$', '<$SelfTemplateDir$ replacement is not supported in plugins.>', [rfReplaceAll]);
  Result := StringReplace(Result, '$AppDir$', ExtractFileDir(ParamStr(0)), [rfReplaceAll]);
end;


